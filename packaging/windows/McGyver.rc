// McGyver.exe's icon and the details Explorer and Task Manager show. build.sh fills in the
// version, compiles this with `zig rc` (0.12 or later) and links it into the exe.
#pragma code_page(65001)

1 ICON "McGyver.ico"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@,0
PRODUCTVERSION @VERSION_COMMAS@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "McGyver"
            VALUE "ProductName", "McGyver"
            VALUE "InternalName", "McGyver"
            VALUE "OriginalFilename", "McGyver.exe"
            VALUE "FileVersion", "@VERSION@"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "LegalCopyright", "© 2026 The McGyver authors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
