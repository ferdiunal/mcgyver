{
  "name": "McGyver",
  "short_name": "McGyver",
  "description": "A file wheel at your cursor: drag a file, hold Shift, and convert, compress, zip or share it. Free and open source for KDE Plasma 6, macOS and Windows.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#0B0D10",
  "theme_color": "#0B0D10",
  "icons": [
    { "src": "/assets/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
